{
  "name": "veilcore-records",
  "version": "0.15.0",
  "description": "Build, commit and verify VeilCore records. No chain dependency.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "conformance",
    "profiles",
    "examples",
    "SPEC.md",
    "INTEGRATING.md",
    "EVIDENCE.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "build": "node scripts/embed-verifier.mjs && tsc",
    "clean": "node scripts/clean.mjs",
    "test": "node --test test/*.test.mjs && npm run checks && npm run conformance",
    "conformance": "node conformance/run.mjs",
    "conformance:python": "node conformance/run-cli.mjs \"python3 conformance/impl.py\"",
    "conformance:generate": "node conformance/generate.mjs",
    "checks": "for f in test/*.checks.mjs; do node \"$f\" || exit 1; done",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run conformance:python && node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunterincoming/veilcore-sdk.git"
  },
  "homepage": "https://veilcore.org",
  "bugs": {
    "url": "https://github.com/hunterincoming/veilcore-sdk/issues"
  },
  "author": "VeilCore",
  "keywords": [
    "provenance",
    "plant-genetics",
    "seed",
    "records",
    "commitment",
    "merkle",
    "attestation",
    "standards",
    "tamper-evident"
  ],
  "bin": {
    "veilcore": "bin/veilcore.mjs"
  }
}
